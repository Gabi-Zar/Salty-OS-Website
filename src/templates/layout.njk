<!doctype html>
<html lang="{{ lang }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ title }}</title>
        <meta name="description" content="{{ description }}" />
        <meta property="og:site_name" content="Salty OS" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:description" content="{{ description }}" />
        <meta property="og:url" content="{{ siteUrl }}{{ "" if lang == defaultLang else "/" ~ lang }}{{ pagePath }}" />
        <meta property="og:image" content="{{ image }}" />
        <meta property="og:locale" content="{{ locale }}" />
        {% for locale in altLocales %}
            <meta property="og:locale:alternate" content="{{ locale }}" />
        {% endfor %}

        <link rel="preload" href="/font/Rubik.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="stylesheet" href="/styles.css" />
        <link rel="icon" type="image/x-icon" href="/assets/logo.png" />

        <link rel="canonical" href="{{ siteUrl }}{{ "" if lang == defaultLang else "/" ~ lang }}{{ pagePath }}" />
        {% for lang in langs %}
            <link rel="alternate" hreflang="{{ lang }}" href="{{ siteUrl }}{{ "" if lang == defaultLang else "/" ~ lang }}{{ pagePath }}" />
        {% endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ siteUrl }}{{ pagePath }}" />
    </head>

    <body>
        {% include "partials/header.njk" %}
        {% block content %}
        {% endblock %}
        {% include "partials/footer.njk" %}

        <script src="https://cdn.jsdelivr.net/npm/lottie-web@5.13.0/build/player/lottie_light.min.js"></script>
        <script type="module" src="/dist/script.js"></script>
    </body>
</html>
